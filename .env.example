# GrafikRaboty Environment Variables
# Скопируйте этот файл в .env и заполните значения

# =====================================================
# Flask Configuration
# =====================================================
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production

# =====================================================
# Database Configuration (PostgreSQL)
# =====================================================
POSTGRES_DB=grafikraboty
POSTGRES_USER=grafik
POSTGRES_PASSWORD=grafik_secret_2026_change_this
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =====================================================
# Redis Configuration (для Socket.IO)
# =====================================================
REDIS_URL=redis://redis:6379/0

# =====================================================
# Telegram Bot Configuration
# =====================================================
TELEGRAM_BOT_TOKEN=8755572729:AAGAvyRp6Uni_wCbwjGIe2WRLOPUSlQ3iAc
ADMIN_USER_ID=701768868

# =====================================================
# VKontakte Configuration
# =====================================================
VK_TOKEN=your_vk_token_here
VK_GROUP_ID=199112265
ADMIN_VK_ID=146411666

# =====================================================
# Network Configuration
# =====================================================
# Локальный IP сервера в сети
LOCAL_IP=192.168.1.207

# Внешний IP сервера (белый IP)
PUBLIC_IP=81.23.181.238

# =====================================================
# Tunnel Configuration (loca.lt)
# =====================================================
TUNNEL_ENABLED=true
TUNNEL_URL=https://rotten-hands-run.loca.lt
TUNNEL_PASSWORD=81.23.181.238

# =====================================================
# File Upload Configuration
# =====================================================
MAX_CONTENT_LENGTH=209715200
UPLOAD_FOLDER=/app/uploads

# =====================================================
# Session Configuration
# =====================================================
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800

# =====================================================
# Logging Configuration
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/web_server.log

# =====================================================
# Socket.IO Configuration
# =====================================================
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ORIGINS=*

# =====================================================
# Development Mode (только для локальной разработки!)
# =====================================================
# Для production оставьте False
DEBUG_MODE=False
