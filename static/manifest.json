      "icons": [{ "src": "/static/images/vetgid-logo.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", ".xlsx", ".xls"]
        }
      ]
    }
