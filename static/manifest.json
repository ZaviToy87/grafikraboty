  "icons": [
    {
      "src": "/static/images/vetgid-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/images/vetgid-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/static/images/screenshot-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "График",
      "short_name": "График",
      "description": "Открыть график работы",
      "url": "/?view=schedule",
      "icons": [{ "src": "/static/images/vetgid-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Задачи",
      "short_name": "Задачи",
      "description": "Открыть задачи",
      "url": "/?view=tasks",
      "icons": [{ "src": "/static/images/vetgid-logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Чат",
      "short_name": "Чат",
      "description": "Открыть чат",
